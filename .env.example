# Base URL of the CDN where omarchy-theme-registry publishes the catalog.
# Currently the temporary R2 public dev URL; production will be https://cdn.themes.omarchy.org.
CDN_BASE_URL=https://pub-<...>.r2.dev

# Optional: point straight at a catalog file instead (overrides CDN_BASE_URL).
# CATALOG_URL=https://example.com/v1/catalog.json
