<% content_for :title, "Themes by #{@login} — Omarchy Themes" %>
<% content_for :description, "#{pluralize(@themes.size, 'community theme')} for Omarchy by #{@login}." %>
<section class="border-b border-border">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-xs text-muted-foreground">
      <a href="<%= root_path(anchor: "themes") %>" class="hover:text-foreground">Themes</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span class="text-foreground"><%= @login %></span>
    </nav>
    <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="font-heading text-2xl font-semibold tracking-tight sm:text-3xl">Themes by <%= @login %></h1>
        <p class="mt-1.5 text-sm text-muted-foreground"><%= pluralize(@themes.size, "theme") %> in the marketplace</p>
      </div>
      <%= ui_button href: @themes.first.author_url, variant: :outline, class: "gap-1.5" do %>
        <%= icon :github, class: "size-4" %> <%= @login %> on GitHub
      <% end %>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% @themes.each do |theme| %><%= render "themes/card", theme: theme %><% end %>
    </div>
  </div>
</section>
