<%= ui_card class: "pt-0" do %>
  <a href="<%= theme_path(theme) %>" class="group relative block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" data-turbo-frame="_top">
    <% if theme.new? %>
      <%= ui_badge "New", class: "absolute top-2 left-2 z-10" %>
    <% end %>
    <%= image_tag theme.image, alt: "#{theme.name} theme preview", loading: "lazy", width: 1200, height: 675,
          style: "background-color: #{theme.placeholder}",
          class: "aspect-video w-full border-b border-border object-cover transition-transform duration-300 ease-out group-hover:scale-105" %>
  </a>
  <%= ui_card_content class: "flex items-center justify-between gap-3" do %>
    <div class="min-w-0">
      <a href="<%= theme_path(theme) %>" class="block truncate text-sm font-medium transition-colors hover:text-primary" data-turbo-frame="_top"><%= theme.name %></a>
      <p class="truncate text-xs text-muted-foreground">by <%= theme.author_login %></p>
    </div>
    <%# Likes are built (themes/_like_button) but off for v1; see plan.md. %>
    <a href="<%= theme.repo %>" class="inline-flex h-7 shrink-0 items-center gap-1 px-1.5 text-xs tabular-nums text-muted-foreground transition-colors hover:text-primary"
       title="GitHub stars" aria-label="<%= pluralize(theme.stars, "GitHub star") %>">
      <%= icon :star, class: "size-4" %><%= number_to_human(theme.stars, format: "%n%u", units: { thousand: "k" }, precision: 1, significant: false, strip_insignificant_zeros: true) %>
    </a>
  <% end %>
<% end %>
