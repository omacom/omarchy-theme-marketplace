<% content_for :title, "Not found — Omarchy Themes" %>
<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <h1 class="font-heading text-2xl font-semibold tracking-tight sm:text-3xl">Not found</h1>
  <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted-foreground">
    There is no theme or page at this address. It may have been removed from the catalog, or the link is wrong.
  </p>
  <div class="mt-6">
    <%= ui_button "Browse all themes", href: root_path(anchor: "themes") %>
  </div>
</section>
