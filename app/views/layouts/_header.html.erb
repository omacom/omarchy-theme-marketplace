<header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-lg">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4 sm:px-6">
    <a href="<%= root_path %>" class="flex shrink-0 items-center gap-2" aria-label="Omarchy Themes home">
      <%= render "brand/mark", class: "size-5 text-primary" %>
      <span class="font-mono text-[15px] font-semibold tracking-tight text-foreground uppercase">
        Theme Marketplace
      </span>
    </a>

    <div class="ml-auto flex items-center gap-1.5">
      <%= ui_button "Submit a theme", href: guide_path %>
      <%= render "layouts/theme_toggle" %>
      <%# Sign-in is wired (/login, /me) but hidden until likes or submissions need it; see plan.md. %>
      <% if signed_in? %>
        <a href="<%= me_path %>" class="flex size-8 shrink-0 items-center justify-center border border-border" aria-label="Your themes">
          <img src="<%= current_user.avatar_url %>" alt="" width="32" height="32" class="size-full object-cover">
        </a>
      <% end %>
    </div>
  </div>
</header>
