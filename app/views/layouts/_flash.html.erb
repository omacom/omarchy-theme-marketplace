<% if flash.any? %>
  <div class="mx-auto max-w-6xl px-4 pt-4 sm:px-6">
    <% flash.each do |kind, message| %>
      <p role="status" class="border px-3 py-2 text-xs <%= kind == "alert" ? "border-destructive/50 text-destructive" : "border-border text-muted-foreground" %>"><%= message %></p>
    <% end %>
  </div>
<% end %>
