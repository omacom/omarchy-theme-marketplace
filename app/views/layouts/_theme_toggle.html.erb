<%= ui_button variant: :ghost, size: :icon, "aria-label": "Toggle colour theme", data: { controller: "theme", action: "theme#toggle" } do %>
  <%= icon :sun, class: "h-[1.2rem] w-[1.2rem] scale-100 rotate-0 transition-all! dark:scale-0 dark:-rotate-90" %>
  <%= icon :moon, class: "absolute h-[1.2rem] w-[1.2rem] scale-0 rotate-90 transition-all! dark:scale-100 dark:rotate-0" %>
<% end %>
