<section id="figures" class="border-t border-border">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-24">
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      <% stats.each do |stat| %>
        <%= ui_card class: "relative transition-shadow hover:ring-primary/40" do %>
          <%= ui_card_content class: "flex h-full flex-col gap-4" do %>
            <div class="flex items-start justify-between gap-3">
              <span class="font-heading text-[11px] font-medium tracking-widest text-muted-foreground uppercase"><%= stat[:label] %></span>
              <span class="flex size-7 shrink-0 items-center justify-center border border-border text-muted-foreground" aria-hidden="true">
                <% if stat[:icon] == :mark %>
                  <%= render "brand/mark", class: "size-3.5" %>
                <% else %>
                  <%= icon stat[:icon], class: "size-3.5" %>
                <% end %>
              </span>
            </div>

            <span class="font-heading text-4xl font-semibold tracking-tight text-primary tabular-nums sm:text-5xl"><%= number_with_delimiter(stat[:value]) %></span>

            <div class="mt-auto flex flex-col gap-2">
              <% if stat[:pct] %>
                <div class="h-1 w-full overflow-hidden bg-muted" role="presentation">
                  <div class="h-full bg-primary" style="width: <%= stat[:pct] %>%"></div>
                </div>
              <% end %>
              <span class="text-[13px] text-muted-foreground"><%= stat[:detail] %></span>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <% if top_artists.present? %>
      <div class="mt-4">
        <%= ui_card do %>
          <%= ui_card_header do %>
            <%= ui_card_title "Top artists" %>
            <%= ui_card_description do %>Ranked by themes published, ties broken by total stars. <%= link_to "All artists", artists_path, class: "text-foreground hover:text-primary" %><% end %>
          <% end %>
          <%= ui_card_content do %>
            <ol class="flex flex-col divide-y divide-border">
              <% top_artists.each_with_index do |artist, i| %>
                <li class="flex items-center gap-3 py-3 first:pt-0 last:pb-0">
                  <span class="w-4 shrink-0 text-right font-heading text-sm text-muted-foreground tabular-nums"><%= i + 1 %></span>
                  <%= image_tag "https://github.com/#{artist[:login]}.png?size=64", alt: "", width: 32, height: 32,
                        class: "size-8 shrink-0 border border-border object-cover" %>
                  <a href="<%= artist_path(artist[:login]) %>" class="min-w-0 flex-1 truncate text-sm font-medium hover:text-primary"><%= artist[:login] %></a>
                  <span class="shrink-0 text-xs text-muted-foreground tabular-nums"><%= pluralize(artist[:count], "theme") %></span>
                  <span class="flex shrink-0 items-center gap-1 text-xs text-muted-foreground tabular-nums">
                    <%= icon :star, class: "size-3.5" %><%= number_with_delimiter(artist[:stars]) %>
                  </span>
                </li>
              <% end %>
            </ol>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
